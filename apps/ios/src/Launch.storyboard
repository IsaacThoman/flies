<?xml version="1.0" encoding="UTF-8"?>
<!--
  The launch screen: the launch image (generated into the asset catalog by scripts/ios.ts),
  filling the screen of any shape, as GameViewController shows it over the game until the game
  has drawn its first screen. A storyboard because UILaunchScreen can't scale an image to fill.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="Launch Image" translatesAutoresizingMaskIntoConstraints="NO" id="image"/>
                        </subviews>
                        <color key="backgroundColor" red="0.015686274509803921" green="0.070588235294117646" blue="0.16862745098039217" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="image" firstAttribute="top" secondItem="root" secondAttribute="top" id="top"/>
                            <constraint firstItem="image" firstAttribute="bottom" secondItem="root" secondAttribute="bottom" id="bottom"/>
                            <constraint firstItem="image" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="leading"/>
                            <constraint firstItem="image" firstAttribute="trailing" secondItem="root" secondAttribute="trailing" id="trailing"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="Launch Image" width="1024" height="1024"/>
    </resources>
</document>
