# For your own host behind your own HTTPS reverse proxy (docs/deploy.md);
# Coolify needs none of these.
# The site's public https:// address, for absolute social-preview URLs, baked
# into the image (optional; Coolify supplies its own per deployment).
FLY_SITE_URL=https://flies.isaacthoman.com/
# The Apple Team ID (ten capital letters and digits, from developer.apple.com/account,
# Membership details) of the account the iPhone and iPad app is published from. With it the
# site serves /.well-known/apple-app-site-association, so table links open the app and the
# app's password AutoFill offers the site's passwords; left blank, there is no such file.
APPLE_TEAM_ID=

# The host port Caddy answers plain HTTP on (compose.override.yaml);
# 127.0.0.1:8080 keeps it to a proxy on the same host.
# HTTP_PORT=8080
# Proxies whose X-Forwarded-For is believed, as Caddy's trusted_proxies
# ranges: private_ranges, or CIDRs such as 203.0.113.7/32.
# TRUSTED_PROXIES=private_ranges
# Headers naming the visitor, the first present wins; behind Cloudflare:
# CF-Connecting-IP X-Forwarded-For
# CLIENT_IP_HEADERS=X-Forwarded-For
# ROOMS_HOST=rooms
# ROOMS_PORT=3000
