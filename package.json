{
  "name": "flies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A simulated fruit fly that lives on your Apple TV",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p .",
    "test": "node --test 'apps/*/tests/*.test.ts' 'packages/*/src/**/*.test.ts' 'packages/*/tests/*.test.ts' && npm run -s test:budgets",
    "test:budgets": "node --test --test-concurrency=1 'apps/*/tests/*.budget.ts' 'packages/*/src/**/*.budget.ts' 'packages/*/tests/*.budget.ts'",
    "e2e": "node apps/web/e2e/play.e2e.ts && node apps/web/e2e/pointer.e2e.ts && node apps/web/e2e/web.e2e.ts && node apps/web/e2e/tables.e2e.ts",
    "serve": "node scripts/serve.ts",
    "rooms": "node apps/server/src/server.ts",
    "tables": "node scripts/tables.ts",
    "tvos": "node scripts/tvos.ts",
    "tvos:check": "node apps/tvos/tests/simulator.tvos.ts",
    "tvos:soak": "node scripts/tvosSoak.ts",
    "tvos:typecheck": "tsc -p apps/tvos",
    "tvos:art": "node scripts/art.ts",
    "store:shots": "node scripts/storeShots.ts",
    "ios": "node scripts/ios.ts",
    "ios:check": "node apps/ios/tests/simulator.ios.ts",
    "brain:fetch": "node packages/brain/scripts/fetch.ts",
    "brain:pack": "node packages/brain/scripts/pack.ts",
    "brain:wasm": "packages/brain-native/wasm.sh",
    "fly:viewer": "vite --config packages/fly/viewer/vite.config.ts",
    "fuzz": "node scripts/fuzz.ts",
    "fuzz:rooms": "node scripts/fuzzRooms.ts",
    "soak:web": "node scripts/webSoak.ts",
    "e2e:soak": "node scripts/webSoak.ts --quick",
    "release": "semantic-release"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "1.58.2",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.4"
  }
}
