{
  "name": "apple-tv-fly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A simulated fruit fly that lives on your Apple TV",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p .",
    "test": "node --test 'apps/*/tests/*.test.ts' 'packages/*/src/**/*.test.ts' 'packages/*/tests/*.test.ts'",
    "tvos": "node scripts/tvos.ts",
    "tvos:check": "node apps/tvos/tests/simulator.tvos.ts",
    "tvos:typecheck": "tsc -p apps/tvos",
    "tvos:art": "node scripts/placeholder-art.ts",
    "brain:fetch": "node packages/brain/scripts/fetch.ts",
    "brain:pack": "node packages/brain/scripts/pack.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "1.58.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.4"
  }
}
