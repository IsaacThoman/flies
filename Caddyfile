# Plain HTTP for any host: Coolify's Traefik or your own HTTPS reverse proxy
# sits in front (docs/deploy.md). Nothing here is kept, so the container needs
# no volumes.
{
	auto_https off
	persist_config off
	servers {
		# Only addresses these proxies forward for are believed: the room server
		# counts password guesses and new rooms by address. Strict reads
		# X-Forwarded-For from the right, so a client cannot claim another address.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
		# Behind Cloudflare, Traefik replaces X-Forwarded-For with Cloudflare's
		# own address; CF-Connecting-IP still names the visitor.
		client_ip_headers {$CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

:80 {
	log

	# A Coolify pull request preview (COOLIFY_BRANCH "pull/<n>/head", quotes
	# and all) reaches its own room server as rooms-pr-<n>, the one name every
	# Coolify version gives it, never production's.
	map {env.COOLIFY_BRANCH} {rooms_upstream} {
		~^"?pull/([0-9]+)/head"?$ {$ROOMS_HOST:rooms}-pr-${1}:{$ROOMS_PORT:3000}
		default {$ROOMS_HOST:rooms}:{$ROOMS_PORT:3000}
	}

	# DNS is resolved on requests, so the site starts before rooms exists.
	@rooms path /rooms /rooms/*
	handle @rooms {
		reverse_proxy {rooms_upstream} {
			# The room server reads the first entry: give it only the client.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		route {
			# Missing data or scripts must be 404s, never the SPA entry; so must the
			# app site association when the build has none (no APPLE_TEAM_ID).
			@spa {
				not path /assets/* /brain/* /sw.js /manifest.webmanifest *.wasm /.well-known/*
				not file {path}
			}
			rewrite @spa /index.html

			header Cache-Control no-cache
			@immutable path /assets/* /brain/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			@js path *.js
			header @js Content-Type "text/javascript; charset=utf-8"
			@manifest path *.webmanifest
			header @manifest Content-Type application/manifest+json
			@binary path *.bin
			header @binary Content-Type application/octet-stream
			@wasm path *.wasm
			header @wasm Content-Type application/wasm
			# It has no extension; Apple's devices read it only as JSON.
			@association path /.well-known/apple-app-site-association
			header @association Content-Type application/json

			# Brain parts are gzip streams decoded by the worker; PNGs are compressed too.
			encode zstd gzip {
				match {
					header Content-Type text/*
					header Content-Type application/json*
					header Content-Type application/manifest+json*
					header Content-Type application/wasm*
					header Content-Type image/svg+xml*
				}
			}
			file_server
		}
	}
}

# Probe the actual entry file without depending on the proxy or the room server.
:8080 {
	bind 127.0.0.1
	root * /srv
	rewrite * /index.html
	file_server
}
